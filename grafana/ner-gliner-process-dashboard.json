          "legendFormat": "gen {{generation}}",
          "refId": "A"
        }
      ],
      "title": "GC collections rate",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Objects collected by the garbage collector per second, by generation.",
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 1 },
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 9, "x": 15, "y": 8 },
      "id": 6,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "rate(python_gc_objects_collected_total[$__rate_interval])",
          "legendFormat": "gen {{generation}}",
          "refId": "A"
        }
      ],
      "title": "GC objects collected rate",
      "type": "timeseries"
    }
  ],
