# Переменные окружения для ner-gliner.
# Запуск: docker run -d -p 8000:8000 --name ner-gliner --env-file .env ner-gliner:1.0

# Число воркеров uvicorn. Каждый воркер держит отдельную копию модели (~1.5 GB RAM).
WORKERS=1

# Имя модели для GLiNER.from_pretrained (должна быть запечена в образ для офлайн-режима).
MODEL_NAME=urchade/gliner_multi-v2.1

# Максимальная длина text / элемента texts в символах. Пусто = без ограничений.
MAX_TEXT_LENGTH=

# Максимальное число элементов texts в /extract_batch. Пусто = без ограничений.
MAX_BATCH_SIZE=10

# Максимальное число элементов labels (до очистки/дедупликации). Пусто = без ограничений.
MAX_LABELS=10

# Значение threshold по умолчанию, если оно не передано в запросе.
DEFAULT_THRESHOLD=0.5

# Уровень логирования: DEBUG, INFO, WARNING, ERROR...
LOG_LEVEL=INFO

# Размер чанка (в словах) для разбиения длинных текстов.
CHUNK_SIZE_WORDS=300

# Адрес Zipkin-коллектора для отправки трейсов, например http://zipkin:9411/api/v2/spans.
# Пусто = трейсинг отключён.
ZIPKIN_ENDPOINT=

# Имя сервиса, под которым трейсы видны в Zipkin/Grafana.
OTEL_SERVICE_NAME=ner-gliner
